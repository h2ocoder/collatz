================================================================================================
A. Exact identities, checked for all 0 <= j <= 400 with Python integers
================================================================================================
  True   pell u^2-8m^2=1
  True   N_j = T_(n_j) = m_j^2
  True   u_(j+1) = 3u_j + 8m_j
  True   n_(j+1) = (3n_j+1) + 4m_j
  True   n_(j-1) = (3n_j+1) - 4m_j
  True   n_(j+1)+n_(j-1) = 2(3n_j+1)
  True   n_(2i) = 8 m_i^2 and n_(2i)+1 = u_i^2
  True   n_(2i+1) = (u_i+4m_i)^2 and n_(2i+1)+1 = 2(u_i+2m_i)^2
  True   v2(m_j) = v2(j)
  True   v2(m_i - m_j) = v2(i - j)   (isometry in j)
  True   m_i - m_j = 2 m_((i-j)/2) u_((i+j)/2)  (i-j even)
  True   u_(j+P) - u_j = 16 m_(P/2) m_(j+P/2)  (P even)
  True   N_(j+P) - N_j = m_P m_(2j+P)
  True   u_j = 3^j mod 8

